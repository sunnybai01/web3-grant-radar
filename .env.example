# PostgreSQL
POSTGRES_USER=web3agent
POSTGRES_PASSWORD=web3agent
POSTGRES_DB=web3agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# LLM Providers (API keys)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# LLM fallback priority (comma-separated: deepseek,qwen,gemini)
LLM_PROVIDER_PRIORITY=deepseek,qwen,gemini

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Security APIs
GOPLUS_API_KEY=
CERTIK_API_KEY=
SCAMSNIFFER_API_KEY=

# Search / discovery (Tavily — LLM-optimized web search)
GITHUB_TOKEN=
TAVILY_API_KEYS=
# 每个 Tavily 源的搜索频率 = 每天的 schedule 轮次 x 每轮预算。
# grant_hackathon 每天 09:00 / 21:00 两轮；冷却要短于 12h，否则 21:00 会卡在边界
# => 每个源每天 2 次搜索。想更省就把冷却拉长或把预算调小。
TAVILY_SUCCESS_COOLDOWN_MINUTES=660
TAVILY_MAX_SOURCES_PER_RUN=14

# Twitter (Twikit)
TWITTER_AUTH_INFO_1=
TWITTER_AUTH_INFO_2=
TWITTER_PASSWORD=
TWITTER_TOTP_SECRET=
TWITTER_COOKIES_FILE=.twitter-cookies.json
SOCIAL_WATCH_INTERVAL_MINUTES=15
TWITTER_FETCH_COUNT=20
# 超过这个天数的推文在抓取时直接跳过
TWITTER_MAX_TWEET_AGE_DAYS=30

# Application
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_MINUTES=30
# 主机休眠后错过的任务最多补跑多晚（分钟）；积压的多次只补一次
SCHEDULER_MISFIRE_GRACE_MINUTES=720
# grant_hackathon 超过这么多小时没有成功完成就发 Slack 告警
PIPELINE_STALE_ALERT_HOURS=14
# 处理失败的原始信号（LLM 不可用、单条出错）下次抓到时重试，最多这么多次
RAW_SIGNAL_MAX_ATTEMPTS=3
# 处理中（pending）超过这么多分钟仍未完成，视为上次运行中断，可以重试
RAW_SIGNAL_PENDING_TIMEOUT_MINUTES=120

# Chat API（必填）：至少 16 位随机字符，必须与 apps/chat-web/.env 中的值一致。
# 为空或过短时 chat-api 拒绝启动。生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHAT_API_INTERNAL_KEY=
